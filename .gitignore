# ==================== Python 缓存 ====================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc

# ==================== 虚拟环境 ====================
venv/
env/
.venv/
.env/
ENV/

# ==================== IDE / 系统 ====================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==================== 构建产物 ====================
build/
dist/
*.exe
build_exe/
develop-eggs/
eggs/
.eggs/
*.egg-info/

# 注意:wuge_tools.spec是PyInstaller打包配置,需提交到git,故不忽略*.spec

# ==================== 用户运行数据(含明文密钥/Cookie,禁止上传) ====================
data_store/
.data_dir_pointer.json

# data目录骨架(用gitkeep保留空目录)
data/*
!data/.gitkeep
data/accounts/*
data/cookies/*
data/firmware/*

# ==================== 日志 / 临时文件 ====================
*.log
*.tmp
*.bak

# ==================== 自更新运行时残留 ====================
_update_stage/
*.old_del
*.new_pending
_update_task.json

# ==================== 本地配置 / 环境变量 ====================
.env
.local_config.json
settings.local.json

# ==================== 测试脚本 ====================
p.py
test_*.py
text_*.py
!test_*.pyc

# ==================== 调试缓存 ====================
.vscode/.cache/
.idea/.cache/
